{
    "compilerOptions": {
        "composite": true,
        "module": "CommonJS",
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "rootDir": ".."
    },
    "include": [
        "src",
        "../client/src/toolchain.ts",
        "../client/src/diagnostics.ts"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
