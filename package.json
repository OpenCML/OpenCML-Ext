{
    "name": "open-cml-extension",
    "displayName": "OpenCML-Ext",
    "description": "OpenCML Extension for VSCode",
    "version": "0.7.0",
    "publisher": "Kogler7",
    "icon": "assets/icon.jpg",
    "type": "module",
    "scripts": {
        "build": "npm run build --workspaces",
        "pub": "node ./publish.js"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Kogler7/OpenCML-Ext.git"
    },
    "activationEvents": [],
    "main": "./dist/extension/extension.cjs",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Camel configuration",
            "properties": {
                "opencmlLanguageServer.camelPath": {
                    "scope": "resource",
                    "type": "string",
                    "default": "camel",
                    "description": "Path to the Camel executable (e.g. camel or /path/to/camel.exe). Sibling tools (camel-ls, camel-format, camel-db) are auto-detected next to it."
                },
                "opencmlLanguageServer.camelDbPath": {
                    "scope": "resource",
                    "type": "string",
                    "default": "",
                    "description": "Path to the Camel debugger executable (camel-db). Empty: resolved next to the Camel executable."
                },
                "opencmlLanguageServer.debugPort": {
                    "scope": "resource",
                    "type": "number",
                    "default": 8765,
                    "description": "TCP port used to talk to the Camel debugger (camel-db serve)."
                },
                "opencmlLanguageServer.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Controls the maximum number of problems produced by the server."
                },
                "opencmlLanguageServer.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the language server."
                }
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "camel.run",
                    "when": "editorLangId == cml",
                    "group": "navigation"
                }
            ],
            "webview/context": [
                {
                    "command": "camel.vizGIR",
                    "when": "webviewId == 'camel'"
                },
                {
                    "command": "camel.run",
                    "when": "webviewId == 'camel' && webviewSection == 'editor'"
                }
            ]
        },
        "commands": [
            {
                "command": "camel.vizGIR",
                "title": "Visualize GraphIR",
                "category": "Camel"
            },
            {
                "command": "camel.run",
                "title": "Run Camel"
            },
            {
                "command": "camel.format",
                "title": "Format Camel Code"
            }
        ],
        "debuggers": [
            {
                "type": "camel",
                "label": "Camel Debug",
                "languages": [
                    "cml"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path of the CML file to debug.",
                                "default": "${file}"
                            },
                            "debugPort": {
                                "type": "number",
                                "description": "Port camel-db serves its API on.",
                                "default": 8765
                            },
                            "camelDbPath": {
                                "type": "string",
                                "description": "Path to camel-db. Default: resolved next to the Camel executable."
                            }
                        }
                    },
                    "attach": {
                        "properties": {
                            "debugPort": {
                                "type": "number",
                                "description": "Port of a running camel-db instance.",
                                "default": 8765
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "camel",
                        "request": "launch",
                        "name": "Debug Camel file",
                        "program": "${file}"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Camel: Debug current file",
                        "description": "Launch camel-db and debug the current CML file.",
                        "body": {
                            "type": "camel",
                            "request": "launch",
                            "name": "Debug Camel file",
                            "program": "${file}"
                        }
                    },
                    {
                        "label": "Camel: Attach to running camel-db",
                        "description": "Attach to a camel-db instance already serving on a port.",
                        "body": {
                            "type": "camel",
                            "request": "attach",
                            "name": "Attach to camel-db",
                            "debugPort": 8765
                        }
                    }
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "cml"
            }
        ],
        "languages": [
            {
                "id": "cml",
                "aliases": [
                    "OpenCML",
                    "cml"
                ],
                "extensions": [
                    ".cml"
                ],
                "icon": {
                    "light": "./assets/logo.svg",
                    "dark": "./assets/logo.svg"
                },
                "configuration": "./language-configuration.json"
            },
            {
                "id": "psl",
                "aliases": [
                    "Photonic Simulation Language",
                    "psl"
                ],
                "extensions": [
                    ".psl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "cml",
                "scopeName": "source.cml",
                "path": "./syntaxes/cml.tmLanguage.json"
            },
            {
                "language": "psl",
                "scopeName": "source.psl",
                "path": "./syntaxes/psl.tmLanguage.json"
            }
        ]
    },
    "private": true,
    "workspaces": [
        "client",
        "server",
        "webview"
    ],
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@vscode/vsce": "^3.6.0",
        "postinstall-postinstall": "^2.1.0",
        "typescript": "^5.8.3"
    },
    "packageManager": "yarn@4.9.4"
}
