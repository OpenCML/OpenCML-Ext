{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Camel",
    "scopeName": "source.cml",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#declarations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#types"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#names"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.cml",
                    "match": "///(?!/)[^\\r\\n\\f]*"
                },
                {
                    "name": "comment.line.double-slash.cml",
                    "match": "//[^\\r\\n\\f]*"
                },
                {
                    "name": "comment.line.number-sign.cml",
                    "match": "#[^\\r\\n\\f]*"
                },
                {
                    "name": "comment.block.cml",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.double.cml",
                    "begin": "\"\"\"",
                    "end": "\"\"\""
                },
                {
                    "name": "string.quoted.triple.single.cml",
                    "begin": "'''",
                    "end": "'''"
                },
                {
                    "name": "string.quoted.double.cml",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.cml",
                            "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.cml",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.cml",
                            "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
                        }
                    ]
                },
                {
                    "name": "string.quoted.backtick.cml",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        {
                            "name": "constant.character.escape.cml",
                            "match": "\\\\(?:x[0-9a-fA-F]{2}|.)"
                        }
                    ]
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "name": "meta.function.declaration.cml",
                    "begin": "\\b(func)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.type.function.cml"
                        }
                    },
                    "end": "(?=\\()|(?=[{};])",
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "match": "\\b(operator)\\b[ \\t]+(\\[\\]|[^\\w\\s(){};]+)(?=[ \\t]*\\()",
                            "captures": {
                                "1": {
                                    "name": "keyword.other.operator.cml"
                                },
                                "2": {
                                    "name": "entity.name.function.operator.cml"
                                }
                            }
                        },
                        {
                            "name": "entity.name.function.cml",
                            "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*\\b"
                        }
                    ]
                },
                {
                    "match": "\\b(type|enum)\\b[ \\t]+([A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.cml"
                        },
                        "2": {
                            "name": "entity.name.type.cml"
                        }
                    }
                },
                {
                    "match": "\\b(namespace|module)\\b[ \\t]+([A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.cml"
                        },
                        "2": {
                            "name": "entity.name.namespace.cml"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.cml",
                    "match": "\\b(?:let|var|from|func|type|with|module|import|export|using|namespace)\\b"
                },
                {
                    "name": "keyword.control.cml",
                    "match": "\\b(?:wait|return|if|then|else|match|case|for|in|throw|loop|while|do|sync|macro)\\b"
                },
                {
                    "name": "keyword.operator.word.cml",
                    "match": "\\b(?:as|const|typeas)\\b"
                },
                {
                    "name": "constant.language.cml",
                    "match": "\\b(?:null|true|false)\\b"
                },
                {
                    "name": "keyword.other.reserved.cml",
                    "match": "\\b(?:is|enum|keyof|typeof|of|try|catch|finally|inner|outer|atomic|shared)\\b"
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "match": "(^[ \\t]*)(@)([A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*)",
                    "captures": {
                        "2": {
                            "name": "punctuation.definition.annotation.cml"
                        },
                        "3": {
                            "name": "entity.name.function.annotation.cml"
                        }
                    }
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.cml",
                    "match": "\\b(?:int|i32|i64|float|f32|f64|bool|string|void|Map|Set)\\b"
                }
            ]
        },
        "calls": {
            "patterns": [
                {
                    "match": "(\\?->|->|\\?\\.\\.|\\.\\.)([ \\t]*)([A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_][A-Za-z_0-9]*)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.cml"
                        },
                        "3": {
                            "name": "entity.name.function.cml"
                        }
                    }
                },
                {
                    "name": "entity.name.function.cml",
                    "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b(?=\\()"
                }
            ]
        },
        "names": {
            "patterns": [
                {
                    "name": "entity.name.namespace.cml",
                    "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b(?=::)"
                },
                {
                    "name": "variable.parameter.cml",
                    "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b(?=[ \\t]*:(?!:))"
                },
                {
                    "name": "constant.language.wildcard.cml",
                    "match": "\\b_\\b"
                },
                {
                    "name": "constant.numeric.hex.cml",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.binary.cml",
                    "match": "\\b0b[01]+\\b"
                },
                {
                    "name": "constant.numeric.real.cml",
                    "match": "\\b(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)\\b"
                },
                {
                    "name": "constant.numeric.integer.cml",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "variable.other.cml",
                    "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.cml",
                    "match": "!==|\\?->|\\?\\.\\.|\\.\\.\\.|===|-=|->|!!|!=|\\?\\?|\\.\\.|@=|\\*=|/=|&&|&=|%=|\\^=|\\+=|<=|==|=>|>=|\\|=|\\|\\||-|!|\\?|@|\\*|/|\\\\|&|%|\\^|\\+|<|=|>|\\||~"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.cml",
                    "match": "::|[,:;.]"
                },
                {
                    "name": "punctuation.section.cml",
                    "match": "[()\\[\\]{}]"
                }
            ]
        }
    }
}
